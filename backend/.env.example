ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api
PROJECT_NAME="IntelliRAG API"
VERSION="0.1.0"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intellirag
VECTOR_DIMENSION=768
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","png","jpg","jpeg","txt","docx","csv"]
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=50
MAX_CHUNK_SIZE=1500
EMBEDDING_MODEL_NAME="sentence-transformers/all-mpnet-base-v2"
EMBEDDING_BATCH_SIZE=32
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_gemini_api_key_here
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
RAG_MAX_CONTEXT_CHARS=12000
RAG_DEFAULT_TOP_K=5
RAG_DEFAULT_SIMILARITY_THRESHOLD=0.25