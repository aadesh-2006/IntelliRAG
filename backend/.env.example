ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api
PROJECT_NAME="IntelliRAG API"
VERSION="0.1.0"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intellirag
VECTOR_DIMENSION=768
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","png","jpg","jpeg","txt","docx","csv"]